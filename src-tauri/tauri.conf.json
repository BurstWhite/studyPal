{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "studyPal",
  "version": "0.1.0",
  "identifier": "app.studypal.desktop",
  "build": {
    "frontendDist": "./placeholder",
    "devUrl": "http://127.0.0.1:47822",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:sidecar"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/studypal-server", "binaries/studypal-eventkit"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
